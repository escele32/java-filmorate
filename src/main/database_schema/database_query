users:
    #получение списка пользователей
    SELECT *
    FROM users;

    #получение пользователя по логину
    SELECT 
      name, 
      email, 
      birthday
    FROM users
    WHERE login = '[Логин]';

films:
    #получение списка фильмов с жанром и рейтингом
    SELECT 
      f.title,
      g.name AS genre_name,
      m.name AS mpa_name,
      f.release_date,
      f.duration
    FROM films f
    JOIN film_genre fg ON f.id = fg.film_id
    JOIN genres g ON fg.genre_id = g.id
    JOIN mpa m ON f.mpa_id = m.id;


    #получение фильма по ID с деталями
    SELECT 
      f.title,
      g.name AS genre_name,
      m.name AS mpa_name
    FROM films f
    JOIN film_genre fg ON f.id = fg.film_id
    JOIN genres g ON fg.genre_id = g.id
    JOIN mpa m ON f.mpa_id = m.id
    WHERE f.id = [ID];


    #получение списка фильмов определённого жанра
    SELECT 
      f.title, 
      f.release_date
    FROM films f
    JOIN film_genre fg ON f.id = fg.film_id
    JOIN genres g ON fg.genre_id = g.id
    WHERE g.name = '[Название жанра]';


genre:
    #получение списка жанров
    SELECT *
    FROM genres;

    #получение жанра по ID
    SELECT name
    FROM genres
    WHERE id = [ID];

mpa:
    #получение списка рейтингов
    SELECT *
    FROM mpa;

    #получение рейтинга по ID
    SELECT name
    FROM mpa
    WHERE id = [ID];

likes:
    #получение списка фильмов, которые лайкнул пользователь
    SELECT 
      f.title, 
      f.release_date
    FROM likes l
    JOIN films f ON l.film_id = f.id
    WHERE l.user_id = [ID пользователя];


    #получение количества лайков для каждого фильма
    SELECT 
      f.title, 
      COUNT(l.id) AS likes_count
    FROM likes l
    JOIN films f ON l.film_id = f.id
    GROUP BY f.id, f.title
    ORDER BY likes_count DESC;


firends:
    #получение списка друзей пользователя
    SELECT 
      u.name, 
      f.status AS friendship_status
    FROM friends f
    JOIN users u ON f.friend_id = u.id
    WHERE f.user_id = [ID пользователя];


    #получение пары друзей с определённым статусом
    SELECT 
      u1.name AS user_name,
      u2.name AS friend_name,
      f.status AS friendship_status
    FROM friends f
    JOIN users u1 ON f.user_id = u1.id
    JOIN users u2 ON f.friend_id = u2.id
    WHERE f.status = '[Статус дружбы]';
